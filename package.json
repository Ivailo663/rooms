{
  "name": "football",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm test -w server && npm run test:unit -w client -- --run",
    "spec:check": "node scripts/spec-check.mjs",
    "lint": "eslint .",
    "format": "prettier .  --write",
    "type-check": "npm run type-check -w client && npm run type-check -w server",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\""
  },
  "packageManager": "npm@8.5.0",
  "keywords": [],
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0"
  }
}
